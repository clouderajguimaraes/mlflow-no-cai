# Copie para env.sh e preencha. Não versione o env.sh (contém segredos).
# Em Jobs/Applications do CAI, prefira cadastrar estas variáveis em Project Settings > Advanced
# (variáveis já definidas no ambiente têm prioridade sobre este arquivo).

# --- Kafka ---
export KAFKA_BOOTSTRAP="broker1.exemplo:9093,broker2.exemplo:9093,broker3.exemplo:9093"
export KAFKA_TOPIC="genai.agent.spans"
export KAFKA_GROUP="cai-genai-eval"
export KAFKA_SECURITY_PROTOCOL="SASL_SSL"
export KAFKA_SASL_MECHANISM="PLAIN"
export KAFKA_SASL_USERNAME="<usuário>"
export KAFKA_SASL_PASSWORD="<senha>"
export KAFKA_SSL_CA="/home/cdsw/ca.pem"          # remova se o CAI já confia na CA do cluster

# --- MLflow ---
export MLFLOW_EXPERIMENT="genai-agent-quality"   # sem "/" no início

# --- Job: leitura (execução agendada) ---
export MAX_MSGS=5000            # para após N mensagens...
export MAX_SECONDS=120          # ...ou T segundos (mantenha bem abaixo do intervalo do agendamento)
export IDLE_SECONDS=15          # ...ou quando o tópico ficar sem mensagens novas
export PENDING_MAX_MIN=30       # quanto tempo um trace sem span raiz espera pelo restante

# --- Juízes (padrão: regras locais, sem LLM) ---
export JUDGE_MODE="rules"       # rules | http
export JUDGE_SAMPLE_RATE=1.0    # fração dos traces enviada aos juízes (use < 1 com LLM, para controlar custo)
# Para plugar LLMs (API compatível com /v1/chat/completions), cada juiz pode ter o seu endpoint:
# export JUDGE_MODE_ADVICE="http"
# export JUDGE_URL_ADVICE="https://<endpoint-guardrail>/v1/chat/completions"
# export JUDGE_MODEL_ADVICE="<modelo, ex.: Llama Guard>"
# export JUDGE_API_KEY_ADVICE="<token>"
# export JUDGE_ADVICE_FORMAT="llamaguard"     # json | llamaguard
# export GUARD_CATEGORIES="S6"                # categorias que contam como violação ("*" = qualquer)
# export JUDGE_MODE_CONTEXT="http"
# export JUDGE_URL_CONTEXT="https://<endpoint-llm>/v1/chat/completions"
# export JUDGE_MODEL_CONTEXT="<modelo instruct>"
# export JUDGE_API_KEY_CONTEXT="<token>"
# (JUDGE_URL / JUDGE_MODEL / JUDGE_API_KEY sem sufixo valem para os dois juízes; JUDGE_CA = CA do endpoint)

# --- Detectores locais opcionais (precisam estar instalados) ---
# export USE_PRESIDIO=1   PRESIDIO_LANG=en
# export USE_DETOXIFY=1

# --- Saída ---
export SINK="parquet"                              # parquet | iceberg
export OUTPUT_DIR="out"
export ICEBERG_TABLE="ai_governance.llm_eval_scores"

# --- Governança: gate de qualidade (opcional) ---
# export QUALITY_GATE="pii_entities/rate<=0,toxicity/rate<=0.05,not_advice_violation/rate<=0.10,context_precision/mean>=0.5"
# export FAIL_ON_GATE=1    # o Job termina com erro (alerta do CAI) se o gate falhar
