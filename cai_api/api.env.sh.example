# Copie para cai_api/api.env.sh (não versionar). Rodando DENTRO de uma sessão do CAI, as variáveis
# CDSW_DOMAIN, CDSW_PROJECT_ID e CDSW_APIV2_KEY já existem e este arquivo é opcional.
export CAI_DOMAIN="ml-xxxx.cloudera.site"        # domínio do workbench (sem https://)
export CAI_API_KEY="<api key>"                   # único passo manual: User Settings > API Keys (escopo: API)
export CAI_PROJECT_NAME="mlflow-cai"
export CAI_JOB_NAME="genai-eval"
# export CAI_CA="/caminho/ca.pem"                # se o TLS do workbench usar CA privada
